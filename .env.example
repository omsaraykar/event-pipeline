COMPOSE_PROJECT_NAME=event-pipeline

KAFKA_BOOTSTRAP_SERVERS=kafka:29092
KAFKA_RAW_TOPIC=events.raw
KAFKA_DLQ_TOPIC=events.dlq
KAFKA_RAW_PARTITIONS=6
KAFKA_REPLICATION_FACTOR=1

MYSQL_DATABASE=events
MYSQL_USER=events
MYSQL_PASSWORD=events_password
MYSQL_ROOT_PASSWORD=root_password
MYSQL_HOST=mysql
MYSQL_PORT=3306

REDIS_HOST=redis
REDIS_PORT=6379
DEDUP_TTL_SECONDS=86400
DEDUP_PROCESSING_TTL_SECONDS=300

EVENT_RATE=10
EVENT_COUNT=1000
MALFORMED_RATE=0.02
INVALID_RATE=0.02
DUPLICATE_RATE=0.05
OUT_OF_ORDER_RATE=0.02
LOG_LEVEL=INFO
